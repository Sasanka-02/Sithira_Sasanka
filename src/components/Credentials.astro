---
/**
 * Purpose: Certifications, vendor platforms and leadership activities.
 */
import { Icon } from 'astro-icon/components';
import { activities, credentials } from '@/data/portfolio';
import type { Credential } from '@/types';

const statusMeta: Record<Credential['status'], { label: string; cls: string; icon: string }> = {
  earned: { label: 'earned', cls: 'badge-green', icon: 'mdi:check-decagram' },
  'in-progress': { label: 'in progress', cls: 'badge-red', icon: 'mdi:progress-clock' },
  'hands-on': { label: 'hands-on', cls: 'badge-muted', icon: 'mdi:console' }
};
---

<section id="credentials" class="section border-t border-line">
  <div class="container-x">
    <div data-reveal>
      <p class="eyebrow"><span class="text-body">//</span> 06 · credentials</p>
      <h2 class="section-title">Certifications &amp; activities</h2>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="card p-6 sm:p-7" data-reveal>
        <h3 class="flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-head">
          <Icon name="mdi:certificate-outline" class="h-5 w-5 text-matrix" /> certs & platforms
        </h3>
        <ul class="mt-6 divide-y divide-line">
          {credentials.map((c) => {
            const meta = statusMeta[c.status];
            return (
              <li class="flex items-start justify-between gap-4 py-4 first:pt-0 last:pb-0">
                <div class="flex min-w-0 gap-3">
                  <Icon name={meta.icon} class:list={['mt-0.5 h-5 w-5 shrink-0', c.status === 'in-progress' ? 'text-crimson' : 'text-matrix']} />
                  <div class="min-w-0">
                    <p class="font-mono text-sm text-head">{c.name}</p>
                    <p class="mt-0.5 text-xs">{c.issuer} · {c.date}</p>
                  </div>
                </div>
                <span class:list={[meta.cls, 'shrink-0']}>{meta.label}</span>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <div class="card p-6 sm:p-7" data-reveal>
          <h3 class="flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-head">
            <Icon name="mdi:account-group" class="h-5 w-5 text-matrix" /> leadership
          </h3>
          <ul class="mt-5 space-y-3">
            {activities.map((a) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                <p class="text-sm"><span class="font-semibold text-head">{a.title}</span>, {a.organization}</p>
                <p class="font-mono text-xs text-body/80">{a.period}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
